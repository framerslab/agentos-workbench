# Backend listen settings
AGENTOS_WORKBENCH_BACKEND_PORT=3001
# The backend has no login. `localhost` keeps it on this machine; `0.0.0.0`
# accepts connections from other machines on the network.
AGENTOS_WORKBENCH_BACKEND_HOST=localhost
# Browser origins allowed to call the backend, comma-separated. Default: the
# front end on ports 5175 and 4173, on localhost and 127.0.0.1.
# AGENTOS_WORKBENCH_ALLOWED_ORIGINS=http://localhost:5175
# Host names the Host header may carry beside localhost and IP addresses, such
# as the name other machines use to reach this one. Every other name is refused,
# which stops DNS rebinding.
# AGENTOS_WORKBENCH_ALLOWED_HOSTS=workbench.lan
# Optional host advertised in Swagger docs; its name is allowed in the Host header too
# AGENTOS_WORKBENCH_PUBLIC_HOST=localhost:3001

# Persistence paths (JSON files)
AGENTOS_WORKBENCH_EVALUATION_STORE_PATH=../.data/evaluation-store.json
AGENTOS_WORKBENCH_PLANNING_STORE_PATH=../.data/planning-store.json

# Model provider key(s) — set any/all that you have
# OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key
# GEMINI_API_KEY=your_gemini_key
# GROQ_API_KEY=your_groq_key
